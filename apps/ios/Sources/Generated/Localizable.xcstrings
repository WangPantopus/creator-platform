    "Continue with Pantopus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with Pantopus"
          }
        }
      }
    },
    "Her AI answers you now. She answers in person when you ask.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Her AI answers you now. She answers in person when you ask."
          }
        }
      }
    },
    "Every message says who wrote it: Maya's AI, Maya herself, or her team. You'll always know which.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every message says who wrote it: Maya's AI, Maya herself, or her team. You'll always know which."
          }
        }
      }
    },
    "One Pantopus account signs you in to every Pantopus app. New here? You'll create it in the next step.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One Pantopus account signs you in to every Pantopus app. New here? You'll create it in the next step."
          }
        }
      }
    },
    "You're talking to {name}'s AI · {name} steps in on request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're talking to {name}'s AI · {name} steps in on request."
