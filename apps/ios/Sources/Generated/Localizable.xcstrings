        }
      }
    },
    "Official means {name} authorized this AI. It does not mean she read your message.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Official means {name} authorized this AI. It does not mean she read your message."
          }
        }
      }
    },
    "Conversations with a creator's AI can be read by that creator and their authorized team. Those accesses are logged. You can delete any conversation at any time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations with a creator's AI can be read by that creator and their authorized team. Those accesses are logged. You can delete any conversation at any time."
          }
        }
      }
    },
    "{name} and her authorized team can separately review this AI conversation. Those accesses are logged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} and her authorized team can separately review this AI conversation. Those accesses are logged."
