{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "env": ["CREATOR_TEST_DATABASE_URL", "CI"]
    },
    "dev": { "cache": false, "persistent": true }
  }
}
